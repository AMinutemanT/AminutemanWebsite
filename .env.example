# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# WARNING: every VITE_* value is compiled into the public JS bundle and is
# readable by anyone who loads the site. Publishable values only.
# Never put a Cloudinary API secret or any signing key here.

# Cloudinary — cloud name and an UNSIGNED upload preset (both public by design)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Web3Forms — access key is public by design
VITE_WEB3FORMS_ACCESS_KEY=
